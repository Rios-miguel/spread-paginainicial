# Copie para .env.local (dev); em produção as variáveis ficam em /opt/spread/site.env no servidor.

# PostgreSQL da Spread, com o usuário site_landing (só INSERT em leads; veja db/0001_leads.sql)
DATABASE_URL=postgresql://site_landing:SENHA@localhost:5432/site

# URL pública do site (metadados/Open Graph)
NEXT_PUBLIC_SITE_URL=https://spread.app.br

# Aviso por e-mail a cada lead novo (Brevo). Sem a chave, o lead é gravado normalmente e só não há aviso.
BREVO_API_KEY=
# Opcionais (padrões: contato@spread.app.br e site@spread.app.br)
LEAD_NOTIFY_TO=contato@spread.app.br
LEAD_NOTIFY_FROM=site@spread.app.br
